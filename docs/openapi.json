{
  "openapi": "3.1.0",
  "info": {
    "title": "MorphieCore HTTP API",
    "version": "0.1.0",
    "description": "HTTP API summary for the local gateway, not full vendor API conformance. Generation uses a typed IR, stateless full history and bounded pre-publication failover. Known fields are strict; unknown generation fields are ignored, not forwarded. Standalone media and Embeddings are frozen and require explicit activation. Codecs define exact admission; docs/usage.md explains setup."
  },
  "servers": [{"url": "http://127.0.0.1:8080"}],
  "security": [{"bearerAuth": []}, {"apiKeyAuth": []}],
  "paths": {
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "List activated task public labels",
        "description": "Activated public labels, sorted and deduplicated. No upstream discovery or pagination. HEAD returns the same headers without a body.",
        "responses": {
          "200": {
            "description": "Complete standard model list, bounded at startup; never a truncated successful prefix.",
            "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModelList"}}}
          },
          "401": {"$ref": "#/components/responses/Error"},
          "405": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/models/{model}": {
      "parameters": [{
        "in": "path", "name": "model", "required": true,
        "schema": {"$ref": "#/components/schemas/PublicModelLabel"}
      }],
      "get": {
        "operationId": "retrieveModel",
        "summary": "Retrieve an activated public model",
        "responses": {
          "200": {
            "description": "The same model object as in the list; no Provider or account information.",
            "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Model"}}}
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "405": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      },
      "delete": {
        "operationId": "deleteModel",
        "summary": "Reject deletion without fine-tuned model ownership",
        "description": "No deletion capability. Activated labels return 403; unknown or inactive labels return 404. No local or upstream mutation.",
        "responses": {
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "chatCompletion",
        "parameters": [{"$ref": "#/components/parameters/ConversationId"}],
        "summary": "Generate with Chat Completions",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChatRequest"}}}
        },
        "responses": {
          "200": {"$ref": "#/components/responses/Generation"},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "405": {"$ref": "#/components/responses/Error"},
          "408": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "415": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "502": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"},
          "504": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/messages": {
      "post": {
        "operationId": "createMessage",
        "parameters": [{"$ref": "#/components/parameters/ConversationId"}],
        "summary": "Generate with Anthropic Messages",
        "description": "Uses the public model's Chat candidates, not necessarily a native Anthropic upstream. Handler errors use Anthropic envelopes; ingress auth errors use the shared OpenAI envelope.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MessagesRequest"}}}
        },
        "responses": {
          "200": {"$ref": "#/components/responses/MessagesGeneration"},
          "400": {"$ref": "#/components/responses/MessagesError"},
          "401": {"$ref": "#/components/responses/Error"},
          "402": {"$ref": "#/components/responses/MessagesError"},
          "404": {"$ref": "#/components/responses/MessagesError"},
          "405": {"$ref": "#/components/responses/Error"},
          "408": {"$ref": "#/components/responses/MessagesError"},
          "413": {"$ref": "#/components/responses/MessagesError"},
          "415": {"$ref": "#/components/responses/MessagesError"},
          "429": {"$ref": "#/components/responses/MessagesError"},
          "500": {"$ref": "#/components/responses/MessagesError"},
          "502": {"$ref": "#/components/responses/MessagesError"},
          "503": {"$ref": "#/components/responses/MessagesError"},
          "504": {"$ref": "#/components/responses/MessagesError"},
          "529": {"$ref": "#/components/responses/MessagesError"}
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "operationId": "createEmbedding",
        "summary": "Embed an ordered text batch through an explicitly activated fixed target",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmbeddingRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Complete float vectors and reported usage after validated EOF. Fixed activated target, no fallback. Invalid indices, dimensions or incomplete batches fail.",
            "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmbeddingResponse"}}}
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "405": {"$ref": "#/components/responses/Error"},
          "408": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "415": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "502": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"},
          "504": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/images/generations": {
      "post": {
        "operationId": "imageGeneration",
        "summary": "Generate an ordered inline image collection using the static GPT Image profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageGenerationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete inline images after validated EOF. The count must match the request; short or invalid collections fail. Explicit activation and a single-source, non-fallback pool are required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageGenerationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "408": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/audio/transcriptions": {
      "post": {
        "operationId": "createTranscription",
        "summary": "Transcribe one bounded WAV/MP3 upload through an explicitly activated binding",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {"$ref": "#/components/schemas/TranscriptionRequest"},
              "encoding": {"file": {"contentType": "audio/wav, audio/x-wav, audio/mpeg, audio/mp3, application/octet-stream"}}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete text and reported duration usage after validated EOF. Native ancillary reports stay in the IR and are omitted by a named JSON projection.",
            "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TranscriptionResponse"}}}
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "405": {"$ref": "#/components/responses/Error"},
          "408": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "415": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "502": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"},
          "504": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/audio/speech": {
      "post": {
        "operationId": "createSpeech",
        "summary": "Generate bounded binary audio through an explicitly activated Speech binding",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SpeechRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Bounded nonempty audio after validated EOF, not low-latency streaming. MIME comes from the admitted report. Native ancillary reports stay in the IR; no invented usage or transcript.",
            "headers": {
              "Cache-Control": {"schema": {"type": "string", "const": "no-store"}},
              "X-Content-Type-Options": {"schema": {"type": "string", "const": "nosniff"}}
            },
            "content": {
              "application/octet-stream": {"schema": {"type": "string", "format": "binary"}},
              "audio/mpeg": {"schema": {"type": "string", "format": "binary"}},
              "audio/opus": {"schema": {"type": "string", "format": "binary"}},
              "audio/aac": {"schema": {"type": "string", "format": "binary"}},
              "audio/flac": {"schema": {"type": "string", "format": "binary"}},
              "audio/wav": {"schema": {"type": "string", "format": "binary"}},
              "audio/pcm": {"schema": {"type": "string", "format": "binary"}}
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "405": {"$ref": "#/components/responses/Error"},
          "408": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "415": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "502": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"},
          "504": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/responses": {
      "post": {
        "operationId": "response",
        "parameters": [{"$ref": "#/components/parameters/ConversationId"}],
        "summary": "Generate with stateless Responses",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResponsesRequest"}}}
        },
        "responses": {
          "200": {"$ref": "#/components/responses/Generation"},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "405": {"$ref": "#/components/responses/Error"},
          "408": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "415": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "502": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"},
          "504": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ConversationId": {
        "in": "header", "name": "X-MorphieCore-Conversation-Id", "required": false,
        "schema": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[\\u0021-\\u002b\\u002d-\\u007e]+$"},
        "description": "Logical conversation ID, stable across turns and model changes. Duplicate headers are rejected. Without it, ingress checks X-Session-Id, session_id, then session-id. It groups routing/cache affinity, not authorization or stored history. Optional prefix cache reuse is independent."
      }
    },
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "description": "Configured ingress token. Use exactly one Bearer header or one x-api-key header, never both."},
      "apiKeyAuth": {"type": "apiKey", "in": "header", "name": "x-api-key", "description": "The same ingress token, not an upstream key. Duplicates and simultaneous Bearer auth are rejected."}
    },
    "schemas": {
      "EmbeddingRequest": {
        "type": "object", "required": ["model", "input"], "additionalProperties": false,
        "properties": {
          "model": {"$ref": "#/components/schemas/PublicModelLabel"},
          "input": {
            "oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 262144},
              {"type": "array", "minItems": 1, "maxItems": 128,
                "items": {"type": "string", "minLength": 1, "maxLength": 262144}}
            ]
          },
          "dimensions": {"type": "integer", "minimum": 1, "maximum": 8192},
          "encoding_format": {"const": "float", "default": "float"},
          "user": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "description": "Text input and float output only. Aggregate text is bounded to 256 KiB UTF-8; ingress may be tighter. Target-specific limits also apply. SDK callers must select encoding_format=float rather than Base64."
      },
      "EmbeddingResponse": {
        "type": "object", "required": ["object", "model", "data", "usage"], "additionalProperties": false,
        "properties": {
          "object": {"const": "list"},
          "model": {"type": "string", "minLength": 1, "maxLength": 256},
          "data": {
            "type": "array", "minItems": 1, "maxItems": 128,
            "items": {"$ref": "#/components/schemas/EmbeddingVector"}
          },
          "usage": {
            "type": "object", "required": ["prompt_tokens", "total_tokens"], "additionalProperties": false,
            "properties": {
              "prompt_tokens": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
              "total_tokens": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
            }
          }
        },
        "description": "Reported model and vector order are preserved. Runtime checks complete unique indices, widths, dimensions, budgets and total_tokens >= prompt_tokens. Missing usage or incomplete transport fails."
      },
      "EmbeddingVector": {
        "type": "object", "required": ["object", "index", "embedding"], "additionalProperties": false,
        "properties": {
          "object": {"const": "embedding"},
          "index": {"type": "integer", "minimum": 0, "maximum": 127},
          "embedding": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"type": "number"}}
        }
      },
      "Model": {
        "type": "object", "required": ["id", "object", "created", "owned_by"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/components/schemas/PublicModelLabel"},
          "object": {"const": "model"},
          "created": {
            "type": "integer", "format": "unixtime", "minimum": 1, "maximum": 9223372036854775807,
            "description": "Developer publication time in Unix seconds. Date-only sources use UTC midnight; not a router listing or Gateway startup timestamp."
          },
          "owned_by": {"type": "string", "minLength": 1, "maxLength": 128, "description": "Model developer name, not inference Provider or account owner."},
          "shutdown_date": {"type": ["string", "null"], "format": "date", "description": "Optional standard report; omitted when unreported, not fabricated."}
        }
      },
      "ModelList": {
        "type": "object", "required": ["object", "data"], "additionalProperties": false,
        "properties": {
          "object": {"const": "list"},
          "data": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/Model"}}
        }
      },
      "TranscriptionRequest": {
        "type": "object", "required": ["model", "file"], "additionalProperties": false,
        "properties": {
          "model": {"$ref": "#/components/schemas/PublicModelLabel"},
          "file": {"type": "string", "format": "binary", "minLength": 1, "maxLength": 1048576,
            "description": "One nonempty WAV/MP3 upload, at most 1 MiB. Filename and MIME do not prove valid audio. No URL, file ID or local-path resolution."},
          "language": {"type": "string", "pattern": "^[a-z]{2}(?![\\s\\S])", "description": "Language intent; the selected target must support the code. Not copied into a detected-language report."},
          "response_format": {"const": "json", "default": "json"},
          "stream": {"const": false, "default": false}
        },
        "description": "Multipart, not JSON. Each field occurs at most once. Upload ceiling: 1 MiB plus 16 KiB framing; operator limits may be smaller. No local persistence or audio decoding."
      },
      "TranscriptionResponse": {
        "type": "object", "required": ["text"], "additionalProperties": false,
        "properties": {
          "text": {"type": "string", "maxLength": 1048576, "description": "Complete recognized text, additionally bounded to 1 MiB UTF-8 bytes. Empty text does not itself imply a failure."},
          "usage": {
            "type": "object", "required": ["type", "seconds"], "additionalProperties": false,
            "properties": {
              "type": {"const": "duration"},
              "seconds": {"type": "number", "minimum": 0, "description": "Reported processed audio duration; not inferred from word timestamps or locally measured file metadata."}
            }
          }
        }
      },
      "SpeechRequest": {
        "type": "object",
        "required": ["model", "input", "voice"],
        "additionalProperties": false,
        "properties": {
          "model": {"$ref": "#/components/schemas/PublicModelLabel"},
          "input": {"type": "string", "minLength": 1, "maxLength": 4096},
          "voice": {
            "type": "string", "minLength": 1, "maxLength": 128,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])",
            "description": "Named voice, additionally limited to 128 UTF-8 bytes and the target's explicit allowlist. Custom voice ID objects are not admitted."
          },
          "instructions": {"type": "string", "maxLength": 4096},
          "speed": {"type": "number", "minimum": 0.25, "maximum": 4, "default": 1},
          "response_format": {"enum": ["mp3", "opus", "aac", "flac", "wav", "pcm"], "default": "mp3"},
          "stream_format": {"const": "audio", "default": "audio"}
        },
        "description": "Bounded binary Speech profile. Fields are non-nullable; target voice/format/control admission is separate. Input and instructions also have 16384-byte bounds. PCM is signed 16-bit little-endian, 24 kHz mono. No SSE or injected token cap."
      },
      "ImageGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "$ref": "#/components/schemas/PublicModelLabel"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          },
          "n": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 10,
            "description": "Required delivered count; absent/null means one. A short upstream result fails without supplemental requests."
          },
          "stream": {
            "enum": [
              false,
              null
            ]
          },
          "output_format": {
            "enum": [
              "png",
              "jpeg",
              "webp",
              null
            ]
          },
          "size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImagePixelSize"
              },
              {
                "enum": [
                  "auto",
                  null
                ]
              }
            ]
          },
          "quality": {
            "enum": [
              "auto",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              null
            ]
          },
          "background": {
            "enum": [
              "auto",
              "transparent",
              "opaque",
              null
            ]
          },
          "output_compression": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "moderation": {
            "enum": [
              "auto",
              "low",
              null
            ]
          },
          "user": {
            "type": "string",
            "maxLength": 256
          }
        },
        "description": "Static inline-image profile. Absent, null and explicit controls remain distinct. Compression needs JPEG/WebP; transparency cannot use JPEG. Target admission is separate. Explicit activation is required.",
        "allOf": [
          {
            "not": {
              "required": [
                "output_format",
                "background"
              ],
              "properties": {
                "output_format": {
                  "const": "jpeg"
                },
                "background": {
                  "const": "transparent"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "output_compression"
              ],
              "properties": {
                "output_compression": {
                  "type": "integer"
                }
              }
            },
            "then": {
              "required": [
                "output_format"
              ],
              "properties": {
                "output_format": {
                  "enum": [
                    "jpeg",
                    "webp"
                  ]
                }
              }
            }
          }
        ]
      },
      "ImagePixelSize": {
        "type": "string",
        "pattern": "^(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-6])x(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-6])(?![\\s\\S])",
        "description": "Canonical WIDTHxHEIGHT in pixels, each dimension 1..65536. Target-specific admitted dimensions may be narrower."
      },
      "ImageTokenBreakdown": {
        "type": "object",
        "required": [
          "text_tokens",
          "image_tokens"
        ],
        "additionalProperties": false,
        "properties": {
          "text_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "image_tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ImageUsage": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "input_tokens",
          "input_tokens_details",
          "output_tokens",
          "total_tokens"
        ],
        "additionalProperties": false,
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens_details": {
            "$ref": "#/components/schemas/ImageTokenBreakdown"
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens_details": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageTokenBreakdown"
              },
              {
                "type": "null"
              }
            ]
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "description": "Reported unsigned counts; totals and breakdowns must agree. Missing usage is not invented. A named accounting projection may omit an unrepresentable report while retaining it in the IR; strict routes reject it."
      },
      "ImageGenerationResponse": {
        "type": "object",
        "required": [
          "created",
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "created": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "description": "Ordered artifacts, exactly matching effective n. Decoded aggregate ceiling: 8 MiB; gateway default: 2 MiB, independent of n.",
            "items": {
              "type": "object",
              "required": [
                "b64_json"
              ],
              "additionalProperties": false,
              "properties": {
                "b64_json": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 11184812,
                  "contentEncoding": "base64",
                  "description": "Strict Base64 with nonempty decoded bytes, at most 8 MiB. Gateway/endpoint limits may be tighter. Representation checks do not decode pixels."
                }
              }
            }
          },
          "output_format": {
            "enum": [
              "png",
              "jpeg",
              "webp",
              null
            ]
          },
          "size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImagePixelSize"
              },
              {
                "type": "null"
              }
            ]
          },
          "background": {
            "enum": [
              "transparent",
              "opaque",
              null
            ]
          },
          "quality": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              null
            ]
          },
          "usage": {
            "$ref": "#/components/schemas/ImageUsage"
          }
        },
        "description": "Optional reports preserve absent/null/value and apply uniformly to the collection. Usage belongs to the operation. Image JSON ceiling: 16 MiB; per-image and aggregate decoded limits default to 2 MiB. No URL fetch or private carrier.",
        "allOf": [
          {
            "not": {
              "required": [
                "output_format",
                "background"
              ],
              "properties": {
                "output_format": {
                  "const": "jpeg"
                },
                "background": {
                  "const": "transparent"
                }
              }
            }
          }
        ]
      },
      "PublicModelLabel": {
        "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_.-]+$",
        "description": "Activated public label, without a Provider prefix. Resolves a trusted route; upstream names and credentials remain internal."
      },
      "MessagesRequest": {
        "type": "object", "required": ["model", "max_tokens", "messages"],
        "not": {"required": ["session_id"]},
        "properties": {
          "model": {"$ref": "#/components/schemas/PublicModelLabel"},
          "max_tokens": {"type": "integer", "minimum": 1},
          "messages": {
            "type": "array",
            "items": {
              "type": "object", "required": ["role", "content"],
              "properties": {
                "role": {"enum": ["user", "assistant"]},
                "content": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "object"}}]}
              },
              "additionalProperties": true
            }
          },
          "stream": {"type": ["boolean", "null"], "default": false}
        },
        "additionalProperties": true,
        "description": "Envelope subset. The client codec admits text, thinking, redacted_thinking, tool_use and tool_result blocks plus system, tools, reasoning controls and output_config (effort and a json_schema format). Known values stay strict; active stop_sequences, container, mcp_servers, context_management and compaction are rejected; other unknown fields and client cache markers are ignored by name. Return thinking signatures and redacted thinking data unchanged. Target projection remains separate."
      },
      "MessagesError": {
        "type": "object", "required": ["type", "error"], "additionalProperties": false,
        "properties": {
          "type": {"const": "error"},
          "error": {
            "type": "object", "required": ["type", "message"], "additionalProperties": false,
            "properties": {
              "type": {"enum": ["invalid_request_error", "authentication_error", "permission_error", "not_found_error", "rate_limit_error", "billing_error", "overloaded_error", "api_error"]},
              "message": {"type": "string"}
            }
          }
        }
      },
      "ChatRequest": {
        "type": "object", "required": ["model", "messages"],
        "not": {"required": ["session_id"]},
        "properties": {
          "model": {"$ref": "#/components/schemas/PublicModelLabel"},
          "prompt_cache_key": {"type": ["string", "null"], "maxLength": 256, "description": "Cache-grouping intent, separate from conversation identity. Null is not filled from conversation context; no value guarantees a cache hit."},
          "messages": {"type": "array", "items": {"type": "object", "not": {"required": ["_openbridge"]}}, "description": "Ordered history. Text and selected user image/audio inputs require codec and target admission. Tool results retain call links. Unbound audio IDs and unsupported media are rejected."},
          "modalities": {"type": ["array", "null"], "items": {"enum": ["text", "audio"]}, "minItems": 1, "maxItems": 2, "uniqueItems": true, "description": "Output intent; audio also requires matching options and explicit public/endpoint admission. This schema activates no audio model."},
          "audio": {"type": ["object", "null"], "required": ["format", "voice"], "properties": {"format": {"enum": ["wav", "aac", "mp3", "flac", "opus", "pcm16"]}, "voice": {"type": "string", "minLength": 1, "maxLength": 128}}, "description": "Named-voice output options. Requires audio modality; streaming requires pcm16. Target admission is separate."},
          "stream": {"type": ["boolean", "null"], "default": false},
          "max_completion_tokens": {"type": ["integer", "null"], "minimum": 1, "description": "Default 1024 and ceiling 16384 in CLI bootstrap, when admitted. A target without output-token control receives no fabricated cap."},
          "max_tokens": {"type": ["integer", "null"], "minimum": 1, "deprecated": true, "description": "Deprecated spelling of the same output cap; cannot be combined with max_completion_tokens."},
          "verbosity": {"type": ["string", "null"], "enum": ["low", "medium", "high", null], "description": "Output verbosity, carried to admitted Responses targets. Chat targets reject it; it is never dropped silently."},
          "metadata": {"type": ["object", "null"], "maxProperties": 16, "propertyNames": {"maxLength": 64}, "additionalProperties": {"type": "string", "maxLength": 512}, "description": "Typed request hint, never copied into reported response metadata."},
          "service_tier": {"type": ["string", "null"], "enum": ["auto", "default", "flex", "scale", "priority", "fast", null], "description": "Request hint; the reported effective tier may differ. Endpoint context admission remains independent."},
          "logprobs": {"type": ["boolean", "null"], "description": "Return token probabilities when true; null/false are inactive controls."},
          "top_logprobs": {"type": ["integer", "null"], "minimum": 0, "maximum": 20, "description": "A non-null integer requires logprobs:true; null normalizes to absent."}
        },
        "allOf": [
          {"if": {"required": ["top_logprobs"], "properties": {"top_logprobs": {"type": "integer"}}}, "then": {"required": ["logprobs"], "properties": {"logprobs": {"const": true}}}},
          {"not": {"required": ["max_tokens", "max_completion_tokens"]}}
        ],
        "additionalProperties": true,
        "description": "Envelope subset, not an arbitrary upstream parameter bag. Known fields follow the codec; active stop, functions, function_call and web_search_options are rejected; other unknown fields are ignored by name. Return reasoning_details unchanged for opaque replay. Named projection may omit container boundaries, not call/result identity."
      },
      "ResponsesReasoningSummary": {
        "type": ["string", "null"],
        "enum": ["auto", "concise", "detailed", null],
        "description": "Standard summary control. Boolean false is not a disabled carrier; typed Disabled remains unrepresentable, not omission or null."
      },
      "ResponsesLeafTool": {
        "type": "object", "required": ["type", "name"],
        "properties": {
          "type": {"enum": ["function", "custom"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "async": {"type": "boolean"},
          "defer_loading": {"type": "boolean"}
        },
        "additionalProperties": true,
        "description": "Envelope subset. Parameters, format, strict defaults and dispatch combinations require owning codec/profile checks."
      },
      "ResponsesToolNamespace": {
        "type": "object", "required": ["type", "name", "description", "tools"],
        "properties": {
          "type": {"const": "namespace"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": {"type": "string"},
          "tools": {"type": "array", "minItems": 1, "maxItems": 127, "items": {"$ref": "#/components/schemas/ResponsesLeafTool"}}
        },
        "description": "Ordered non-nested group. Same-kind names are unique within a group; different groups may reuse names. Total definitions plus groups share the tool budget. Calls carry namespace; results refer to call_id."
      },
      "ResponsesRequest": {
        "type": "object", "required": ["model"],
        "not": {"required": ["session_id"]},
        "properties": {
          "model": {"$ref": "#/components/schemas/PublicModelLabel"},
          "prompt_cache_key": {"type": ["string", "null"], "maxLength": 256, "description": "Cache-grouping intent, separate from conversation identity. Null is not filled from conversation context; cache reports remain upstream facts."},
          "input": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "object", "not": {"required": ["_openbridge"]}}}]},
          "tools": {
            "type": "array",
            "maxItems": 128,
            "items": {"oneOf": [{"$ref": "#/components/schemas/ResponsesLeafTool"}, {"$ref": "#/components/schemas/ResponsesToolNamespace"}]},
            "description": "Envelope subset. Namespace choice uses auto/required/none. Schema defaults, dispatch and target admission are checked by the codec."
          },
          "reasoning": {
            "type": ["object", "null"],
            "properties": {
              "summary": {"$ref": "#/components/schemas/ResponsesReasoningSummary"},
              "generate_summary": {"$ref": "#/components/schemas/ResponsesReasoningSummary", "deprecated": true}
            },
            "additionalProperties": true,
            "description": "Other reasoning controls and conflicting aliases are checked by the owning codec and selected target."
          },
          "stream": {"type": ["boolean", "null"], "default": false},
          "max_output_tokens": {"type": ["integer", "null"], "minimum": 1, "description": "Default 1024 and ceiling 16384 in CLI bootstrap, when admitted. SIWC rejects explicit caps; local limits do not bound upstream charges."}
        },
        "additionalProperties": true,
        "description": "Stateless full-history profile. Selected user images/files and tool-result images require explicit public/target admission. File URLs are forwarded only to admitted trusted targets; the gateway never fetches them. No stored history, arbitrary upstream selection or private attachment. Codecs define exact tools, content, replay and projection rules."
      },
      "Error": {
        "type": "object", "required": ["error"], "additionalProperties": false,
        "properties": {"error": {
          "type": "object", "required": ["message", "type", "param", "code"], "additionalProperties": false,
          "properties": {"message": {"type": "string"}, "type": {"type": "string", "enum": ["invalid_request_error", "api_error", "insufficient_quota", "rate_limit_error", "server_error"]}, "param": {"type": "null"}, "code": {"type": "string"}}
        }}
      }
    },
    "responses": {
      "MessagesGeneration": {
        "description": "Anthropic-shaped JSON or SSE under the public model label. Tool calls and reasoning use client block carriers. Completion waits for validated EOF; late failures never become a successful message_stop.",
        "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}},
        "content": {"application/json": {"schema": {"type": "object"}}, "text/event-stream": {"schema": {"type": "string"}}}
      },
      "MessagesError": {
        "description": "Sanitized Messages handler error. Exhausted quota maps to 402; upstream overload maps to 529. Ingress auth and router method errors use the shared OpenAI envelope.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MessagesError"}}}
      },
      "Generation": {
        "description": "JSON or incremental SSE under the public model label. Codecs define typed output and named losses. HTTP 200 is not semantic success: classified errors may use failure frames, and late failures may abort the body. No fabricated successful terminal.",
        "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}},
        "content": {"application/json": {"schema": {"type": "object", "not": {"required": ["_openbridge"]}}}, "text/event-stream": {"schema": {"type": "string"}}}
      },
      "Error": {
        "description": "Sanitized OpenAI error. Ingress authentication uses this envelope on every route; 401 includes WWW-Authenticate: Bearer. No upstream bodies, origins or credentials are echoed.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      }
    }
  }
}
