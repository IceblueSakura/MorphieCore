# Only explicit public templates belong here. Keep edited deployment copies,
# credentials, certificates, logs and capture files outside the repository.
!/config/
/config/*
!/config/*.example.json
!/config/*.example.conf

# Standalone protocol corpus derived artifacts and Python tool environments.
/testdata/generated/
/testdata/reports/
/testdata/dist/
/testdata/runtime/
/tools/corpus/.venv/
/tools/corpus/.pytest_cache/
/tests/sdk/.venv/
/tests/sdk/pi/node_modules/
**/__pycache__/

# JetBrains IDE: share only the project dictionary.
/.idea/*
!/.idea/dictionaries/
/.idea/dictionaries/*
!/.idea/dictionaries/project.xml

